{
  "max_context_tokens": 262144,
  "max_output_tokens": 8192,
  "temperature": 0.7,
  "tool_use": {
    "allowed": ["read", "summarize", "flag", "report"],
    "denied": ["write", "execute", "modify", "delete", "deploy"],
    "approval_required": true
  },
  "safety": {
    "deny_list": ["unsafe", "illegal", "privilege_escalation", "data_exfiltration"],
    "escalation": "human_review"
  },
  "output_format": {
    "machine": "json",
    "human": "markdown",
    "tags": ["action", "risk", "summary"]
  },
  "filtering": {
    "suppress": ["redundant_filler", "unverified_speculation"],
    "elevate": ["actionable_items", "anomalies", "resource_warnings"]
  }
}
